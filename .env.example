# =============================================================================
# SMARTFIT ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env.local' when configuring your local or cloud database.
# DO NOT commit '.env.local' or real secrets to version control.
# =============================================================================

# PostgreSQL Database Connection String (e.g. Neon, Supabase, or local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartfit?schema=public"

# Authentication (Phase 5)
# Generate a long random string (32+ characters). Never commit the real value.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# AI Wellness Coach (To be configured in Phase 17)
# GEMINI_API_KEY="your-gemini-api-key"
